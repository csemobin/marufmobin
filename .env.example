# Contact form mail (Nodemailer adapter)
# Copy to .env.local and fill in real values. Never commit .env.local.

# Gmail account that sends the mail (use an App Password, not your login password)
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact form messages are delivered (defaults to SMTP_USER)
MAIL_TO=you@gmail.com

# Optional overrides (defaults work for Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# MAIL_FROM="Portfolio Contact" <you@gmail.com>
